# 线上环境
ENV = 'production'

# base路径
VITE_BASE_PATH = '/'

# 导出路径
VITE_OUT_DIR = 'dist'

# 线上环境接口地址 - 'getCurrentDomain:表示获取当前域名'
VITE_AXIOS_BASE_URL = 'getCurrentDomain'
VITE_RBAC_BASE_URL = 'http://192.168.124.2:5005/rbacServer'
VITE_RBAC_PROJECT = 'cooper'
VITE_KEYCLOAK_REALM_URL = 'http://192.168.124.2:18085/realms/master'
VITE_KEYCLOAK_CLIENT_ID = 'cooper'

VITE_COOPER_USE_MOCK = 'false'
VITE_COOPER_MOCK_DELAY = 850
VITE_ONLYOFFICE_URL = 'http://192.168.124.2:89/'
VITE_PROXY_MQTT = 'ws://192.168.124.2:8083/mqtt'

# 业务 API 前缀：同域反代保留以下值；直连时改为根目录 API 文档中的完整网关地址。
# VITE_*_API_TARGET 仅用于 Vite 开发代理；生产请求由下面的 BASE_URL 决定。
VITE_COOPER_API_BASE_URL = '/cooperRouter'
VITE_NEW_OA_API_BASE_URL = '/newOARouter'
VITE_PROCESS_API_BASE_URL = '/processRouter'
VITE_MESSAGE_API_BASE_URL = '/MessageCenter'
VITE_LIKE_API_BASE_URL = '/likeFeatureUrl'
VITE_QUALITY_API_BASE_URL = '/YiyanQC'
VITE_AURA_API_BASE_URL = '/aurasearchserviceUrl'
VITE_AURA_SEARCH_BACKEND = 'vector'

# 页面跳转地址与 API 地址分别配置，待内网填写实际前端站点。
VITE_PROCESS_CENTER_URL = ''
# 支持 {taskId} 和 {businessId}；留空时使用流程中心首页。
VITE_PROCESS_TASK_URL = ''
VITE_MESSAGE_CENTER_URL = ''
